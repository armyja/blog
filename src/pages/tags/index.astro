---
import LayoutDefault from 'astro-theme-retyped/layouts/LayoutDefault.astro'
import { getTagUrl, getTags } from 'astro-theme-retyped/utils'
import { t } from 'astro-theme-retyped/i18n-util.ts'

const tags = await getTags()
const list = Array.from(tags).map(([name, posts]) => ({
  name,
  href: getTagUrl(name),
  size: t('tag_count', posts.length),
}))
---

<LayoutDefault>
  <section>
    <h2 class="post-title">{t('Tags')}</h2>
    <ul class="pl-6 list-none flex flex-col gap-4">
      {
        list.map(({ name, href, size }) => (
          <li>
            <h3 class="post-title">
              <a href={href}># {name}</a>
            </h3>
            <p>{size}</p>
          </li>
        ))
      }
    </ul>
  </section>
</LayoutDefault>
